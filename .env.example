# LLM Clinic is BYOK (bring your own key) by default — users paste their
# own API key into the picker in the UI, and it never touches the server's
# disk, database, or logs (it's used in-memory for the single request only).
#
# These env vars are OPTIONAL and only useful if you're self-hosting and
# want to pre-fill default keys server-side instead of typing them in the
# browser every time. Not required to run the project.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq has a free tier and is the recommended zero-cost default —
# get a key at https://console.groq.com
GROQ_API_KEY=
